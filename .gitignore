# Secrets / local env (use docker-compose.yml environment instead)
.env
.env.*
!.env.example

# Local app settings (Docker uses /data volume instead)
data/

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Scrape / probe junk
tools/scrape_out/
_*.html
_*.py
_*.json

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Cursor / agent local state (do not commit)
.cursor/
agent-transcripts/

# graphify local index (regenerate with: graphify extract . --code-only)
graphify-out/

# DENON-REFERENCE probe/session artifacts (never commit)
DENON-REFERENCE/**/cookies.txt
DENON-REFERENCE/**/__pycache__/
DENON-REFERENCE/**/scrape_out/
